{
  "name": "n8n Threat Intelligence Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "security-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -800,
        0
      ],
      "webhookId": "security-alert"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ip",
              "name": "ip",
              "value": "={{ $json.body.ip || $json.ip }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "edit-fields",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -560,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://ipapi.co/{{$json.ip}}/json/",
        "options": {}
      },
      "id": "ip-info",
      "name": "IP Information",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://www.virustotal.com/api/v3/ip_addresses/{{$json.ip}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-apikey",
              "value": "YOUR_VIRUSTOTAL_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "virustotal",
      "name": "VirusTotal Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const stats = $json.data.attributes.last_analysis_stats;\n\nconst malicious = stats.malicious || 0;\nconst suspicious = stats.suspicious || 0;\n\n// Learning-project risk score\nlet riskScore = (malicious * 5) + (suspicious * 2);\n\n// Maximum score = 100\nif (riskScore > 100) {\n  riskScore = 100;\n}\n\nlet severity;\n\nif (riskScore >= 70) {\n  severity = \"HIGH\";\n} else if (riskScore >= 30) {\n  severity = \"MEDIUM\";\n} else {\n  severity = \"LOW\";\n}\n\nreturn [\n  {\n    json: {\n      ip: $('Edit Fields').item.json.ip,\n      malicious,\n      suspicious,\n      riskScore,\n      severity\n    }\n  }\n];"
      },
      "id": "risk-analysis",
      "name": "Risk Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "risk-condition",
              "leftValue": "={{ $json.riskScore }}",
              "rightValue": 30,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-risk",
      "name": "Risk Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "value": "=⚠️ IP SECURITY ALERT\n\nIP: {{ $('Risk Analysis').item.json.ip }}\n\nMalicious detections: {{ $('Risk Analysis').item.json.malicious }}\nSuspicious detections: {{ $('Risk Analysis').item.json.suspicious }}\n\nRisk Score: {{ $('Risk Analysis').item.json.riskScore }}/100\nSeverity: {{ $('Risk Analysis').item.json.severity }}\n\nStatus: Potentially suspicious activity detected.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "alert-message",
      "name": "Create Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        640,
        -120
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "telegram-alert",
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        -120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "value": "=✅ IP SECURITY CHECK\n\nIP: {{ $('Risk Analysis').item.json.ip }}\n\nMalicious detections: {{ $('Risk Analysis').item.json.malicious }}\nSuspicious detections: {{ $('Risk Analysis').item.json.suspicious }}\n\nRisk Score: {{ $('Risk Analysis').item.json.riskScore }}/100\nSeverity: {{ $('Risk Analysis').item.json.severity }}\n\nStatus: No significant malicious activity detected.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normal-message",
      "name": "Create Normal Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        640,
        120
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "telegram-normal",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        120
      ]
    }
  ],
  "connections": {
